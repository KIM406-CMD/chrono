# ============================================================
# Chrono BBS 前端镜像：Node 构建 + Nginx 静态托管
# 构建上下文为仓库根目录：
#   docker build -f deploy/Dockerfile.frontend -t chrono-bbs-frontend .
# ============================================================

FROM node:22-alpine AS build
WORKDIR /app

# 先复制依赖清单，利用 Docker 层缓存
COPY chrono-bbs-client/package.json chrono-bbs-client/package-lock.json ./
RUN npm ci

COPY chrono-bbs-client/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.docker.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
