@startuml 用例图

skinparam packageStyle rectangle

left to right direction

actor 游客 as visitor
actor 用户 as user
actor 商家 as merchant
actor 管理员 as admin

rectangle "网上超市系统" {

  ' ===== 游客用例 =====
  package "游客功能" {
    usecase "浏览商品列表" as UC01
    usecase "查看商品详情" as UC02
    usecase "按分类筛选商品" as UC03
    usecase "关键词搜索商品" as u
    usecase "注册账号" as UC05
    usecase "登录" as UC06
  }

  ' ===== 用户用例 =====
  package "用户功能" {
    usecase "管理收货地址" as UC07
    usecase "添加商品到购物车" as UC08
    usecase "修改购物车数量" as UC09
    usecase "删除购物车商品" as UC10
    usecase "创建订单" as UC11
    usecase "支付订单" as UC12
    usecase "查看订单列表" as UC13
    usecase "确认收货" as UC14
    usecase "取消订单" as UC15
    usecase "申请退款/退货" as UC16
    usecase "发表商品评论" as UC17
    usecase "追加评论" as UC18
    usecase "与商家聊天" as UC19
  }

  ' ===== 商家用例 =====
  package "商家功能" {
    usecase "提交入驻申请" as UC20
    usecase "管理商品(上架/下架/编辑)" as UC21
    usecase "管理库存" as UC22
    usecase "设置商品规格SKU" as UC23
    usecase "查看订单" as UC24
    usecase "发货" as UC25
    usecase "处理退款/退货" as UC26
    usecase "回复评论" as UC27
    usecase "删除不当评论" as UC28
    usecase "与用户聊天" as UC29
    usecase "查看销售统计" as UC30
  }

  ' ===== 管理员用例 =====
  package "管理员功能" {
    usecase "管理用户" as UC31
    usecase "审核商家入驻" as UC32
    usecase "管理商品分类" as UC33
    usecase "管理所有商品" as UC34
    usecase "管理所有订单" as UC35
    usecase "管理所有评论" as UC36
    usecase "查看全局销售报表" as UC37
    usecase "查看操作日志" as UC38
  }
}

' ===== 关系 =====
visitor --> UC01
visitor --> UC02
visitor --> UC03
visitor --> UC04
visitor --> UC05
visitor --> UC06

user --> UC07
user --> UC08
user --> UC09
user --> UC10
user --> UC11
user --> UC12
user --> UC13
user --> UC14
user --> UC15
user --> UC16
user --> UC17
user --> UC18
user --> UC19

merchant --> UC20
merchant --> UC21
merchant --> UC22
merchant --> UC23
merchant --> UC24
merchant --> UC25
merchant --> UC26
merchant --> UC27
merchant --> UC28
merchant --> UC29
merchant --> UC30

admin --> UC31
admin --> UC32
admin --> UC33
admin --> UC34
admin --> UC35
admin --> UC36
admin --> UC37
admin --> UC38

' 用户继承游客
user --|> visitor

' 商家继承用户
merchant --|> user

' 管理员继承用户
admin --|> user

' 支付包含
UC12 ..> UC11 : <<include>>
UC11 ..> UC08 : <<include>>
UC25 ..> UC24 : <<include>>

' 聊天扩展自查看商品
UC19 ..> UC02 : <<extend>>

@enduml