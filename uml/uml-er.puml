product_sku ||--o{ cart_item : "购物车中的SKU"
product_sku ||--o{ order_item : "订单中的SKU"

address ||--o{ order : "订单收货地址"

order ||--o{ order_item : "订单明细"
order ||--o| payment : "支付记录"

order_item ||--o{ refund : "部分退款/退货"

comment ||--o{ comment : "回复/追评"

conversation ||--o{ message : "会话消息"

@enduml