@startuml ER图

skinparam linetype ortho

entity user {
  * id : BIGINT <<PK>>
  --
  * username : VARCHAR(50) <<UK>>
  password : VARCHAR(255)
  nickname : VARCHAR(50)
  phone : VARCHAR(20)
  email : VARCHAR(100)
  avatar : VARCHAR(500)
  role : TINYINT <<1用户/2商家/3管理员>>
  status : TINYINT <<1正常/0禁用>>
  created_at : DATETIME
  updated_at : DATETIME
}

entity merchant {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  shop_name : VARCHAR(100)
  business_license : VARCHAR(500)
  contact_phone : VARCHAR(20)
  status : TINYINT <<0待审核/1已通过/2已拒绝>>
  review_reason : VARCHAR(500)
  reviewed_at : DATETIME
  created_at : DATETIME
  updated_at : DATETIME
}

entity address {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  receiver_name : VARCHAR(50)
  phone : VARCHAR(20)
  province : VARCHAR(50)
  city : VARCHAR(50)
  district : VARCHAR(50)
  detail : VARCHAR(200)
  is_default : TINYINT
  created_at : DATETIME
}

entity category <<三级分类>> {
  * id : BIGINT <<PK>>
  --
  parent_id : BIGINT <<FK, 自关联>>
  name : VARCHAR(50)
  level : TINYINT <<1/2/3>>
  sort_order : INT
  icon : VARCHAR(500)
  created_at : DATETIME
}

entity product {
  * id : BIGINT <<PK>>
  --
  * category_id : BIGINT <<FK>>
  * merchant_id : BIGINT <<FK>>
  name : VARCHAR(200)
  description : TEXT
  images : VARCHAR(2000)
  brand : VARCHAR(100)
  sales : INT
  status : TINYINT <<上架/下架>>
  created_at : DATETIME
  updated_at : DATETIME
}

entity product_sku <<SKU>> {
  * id : BIGINT <<PK>>
  --
  * product_id : BIGINT <<FK>>
  spec_ids : VARCHAR(200)
  spec_text : VARCHAR(200)
  price : INT <<单位:分>>
  stock : INT
  status : TINYINT <<0禁用/1启用>>
  created_at : DATETIME
}

entity spec_template {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(50)
  created_at : DATETIME
}

entity spec_value {
  * id : BIGINT <<PK>>
  --
  * template_id : BIGINT <<FK>>
  value : VARCHAR(50)
  sort_order : INT
}

entity cart_item {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  * sku_id : BIGINT <<FK>>
  quantity : INT
  selected : TINYINT <<0未选中/1已选中>>
  created_at : DATETIME
}

entity order <<主订单>> {
  * id : BIGINT <<PK>>
  --
  * order_no : VARCHAR(32) <<UK>>
  * user_id : BIGINT <<FK>>
  address_snapshot : VARCHAR(500)
  total_amount : INT <<单位:分>>
  status : TINYINT <<1待支付/2已支付/3已发货/4已完成/5已取消/6退款中/7已退款>>
  remark : VARCHAR(500)
  cancel_reason : VARCHAR(500)
  paid_at : DATETIME
  shipped_at : DATETIME
  received_at : DATETIME
  completed_at : DATETIME
  created_at : DATETIME
  updated_at : DATETIME
}

entity order_item <<订单明细>> {
  * id : BIGINT <<PK>>
  --
  * order_id : BIGINT <<FK>>
  product_id : BIGINT <<FK>>
  sku_id : BIGINT <<FK>>
  quantity : INT
  unit_price : INT <<单位:分>>
  subtotal : INT <<单位:分>>
}

entity payment <<支付记录>> {
  * id : BIGINT <<PK>>
  --
  * order_id : BIGINT <<FK>>
  pay_method : TINYINT <<1卡号/2二维码>>
  card_no : VARCHAR(20)
  status : TINYINT <<0处理中/1成功/2失败>>
  paid_at : DATETIME
  created_at : DATETIME
}

entity refund <<退款/退货>> {
  * id : BIGINT <<PK>>
  --
  * order_id : BIGINT <<FK>>
  * order_item_id : BIGINT <<FK>>
  * user_id : BIGINT <<FK>>
  merchant_id : BIGINT <<FK>>
  type : TINYINT <<1退款/2退货>>
  reason : VARCHAR(500)
  amount : INT <<单位:分>>
  status : TINYINT <<0待审核/1已通过/2已拒绝/3待寄回/4待商家收货/5退货完成>>
  reviewer_id : BIGINT <<FK 审核人>>
  review_reason : VARCHAR(500)
  reviewed_at : DATETIME
  return_company : VARCHAR(50)
  return_logistics_no : VARCHAR(50)
  returned_at : DATETIME
  return_received_at : DATETIME
  created_at : DATETIME
}

entity comment <<评论/追评>> {
  * id : BIGINT <<PK>>
  --
  * product_id : BIGINT <<FK>>
  * user_id : BIGINT <<FK>>
  order_item_id : BIGINT <<FK>>
  parent_id : BIGINT <<FK, 自关联回复>>
  content : VARCHAR(1000)
  star : TINYINT <<1-5星>>
  images : VARCHAR(2000)
  is_append : TINYINT <<0首评/1追评>>
  status : TINYINT <<0正常/1已删除>>
  created_at : DATETIME
}

entity search_history {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  keyword : VARCHAR(100)
  searched_at : DATETIME
}

entity seckill_coupon <<秒杀券>> {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  description : VARCHAR(500)
  discount_type : TINYINT <<1满减/2折扣>>
  discount_value : INT <<满减为分/折扣为百分比>>
  min_amount : INT
  total_count : INT
  remain_count : INT
  start_time : DATETIME
  end_time : DATETIME
  per_user_limit : INT
  status : TINYINT <<0未开始/1进行中/2已结束>>
  created_at : DATETIME
  updated_at : DATETIME
}

entity user_coupon <<用户券>> {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  * coupon_id : BIGINT <<FK>>
  status : TINYINT <<0未使用/1已使用/2已过期>>
  used_order_id : BIGINT <<FK>>
  claim_time : DATETIME
  used_time : DATETIME
  created_at : DATETIME
}

entity conversation <<会话>> {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK 买家用户ID>>
  * merchant_id : BIGINT <<FK 商家用户ID(user.id)>>
  product_id : BIGINT <<FK>>
  last_message : VARCHAR(500)
  last_message_time : DATETIME
  user_unread : INT
  merchant_unread : INT
  created_at : DATETIME
  updated_at : DATETIME
}

entity message <<消息>> {
  * id : BIGINT <<PK>>
  --
  * conversation_id : BIGINT <<FK>>
  * sender_id : BIGINT <<FK>>
  sender_role : TINYINT <<0用户/1商家>>
  content : VARCHAR(2000)
  type : TINYINT <<1文本/2图片>>
  is_read : TINYINT
  created_at : DATETIME
}

entity notification <<站内通知>> {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK 接收用户>>
  type : TINYINT <<1订单/2系统/3售后>>
  title : VARCHAR(100)
  content : VARCHAR(500)
  related_type : TINYINT <<1订单/2退款>>
  related_id : BIGINT <<关联业务ID>>
  is_read : TINYINT <<0未读/1已读>>
  created_at : DATETIME
}

entity operation_log <<操作日志>> {
  * id : BIGINT <<PK>>
  --
  user_id : BIGINT
  username : VARCHAR(50)
  ip : VARCHAR(50)
  module : VARCHAR(50)
  action : VARCHAR(200)
  params : TEXT
  result : VARCHAR(50)
  cost_time : BIGINT
  created_at : DATETIME
}

