user ||--o{ comment : "评论"
user ||--o{ search_history : "搜索历史"
user ||--o{ conversation : "发起会话(买家)"
user ||--o{ conversation : "接收会话(商家)"
user ||--o{ message : "发送消息"
user ||--o{ operation_log : "操作日志"

category ||--o| category : "父分类"
category ||--o{ product : "分类下的商品"

merchant ||--o{ product : "商家的商品"

