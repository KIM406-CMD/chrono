@startuml 组件图

title 网上超市系统 - 组件图（Maven多模块结构）

skinparam component {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    FontColor #000000
}

skinparam interface {
    BackgroundColor #FFF3E0
    BorderColor #E65100
}

skinparam database {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
}

skinparam node {
    BackgroundColor #FCE4EC
    BorderColor #C62828
}

' ===== 外部系统 =====
node "阿里云 OSS\n(图片存储，可选)" as OSS
node "Elasticsearch\n(商品搜索)" as ES
database "MySQL\n(主数据库)" as MySQL
database "Redis\n(缓存/会话/防重/秒杀)" as Redis

' ===== Maven 模块 =====
package "chrono-bbs-server (父项目)" {

  component "module-start\n(启动与装配)" as Start #LightBlue {
    [MyApplication\n(SpringBoot启动类)] as Boot
    [application.yml / application-dev.yml\n(全局配置)] as Config
    [WebMvcConfig\n(拦截器注册/静态资源)] as WebMvc
    [SecurityConfig\n(安全配置)] as Security
    [Knife4jConfig\n(接口文档)] as Knife
    [JwtInterceptor\n(JWT鉴权 + Redis 二次校验)] as Jwt
  }

  component "module-api\n(Controller / WebSocket)" as API #LightGreen {
    [AuthController] as Auth
    [ProductController] as Product
    [CategoryController] as Category
    [SearchController] as Search
    [CartController] as Cart
    [OrderController] as Order
    [PaymentController] as Pay
    [RefundController] as Refund
    [AddressController] as Addr
    [CommentController] as Comment
    [MerchantController] as Mc
    [AdminController] as Admin
    [SeckillController] as Seckill
    [UploadController] as Upload
    [ChatController] as Chat
    [ChatWebSocketEndpoint\n(原生WS /chat/{userId})] as Ws
    [GlobalExceptionHandler\n(全局异常处理)] as ExHandler
  }

  component "module-service\n(业务逻辑)" as Service #LightYellow {
    interface "AuthService" as AuthS
    interface "ProductService" as ProdS
    interface "CategoryService" as CatS
    interface "SearchService" as SearchS
    interface "CartService" as CartS
    interface "OrderService" as OrderS
    interface "PaymentService" as PayS
    interface "RefundService" as RefS
    interface "AddressService" as AddrS
    interface "CommentService" as ComS
    interface "MerchantService" as McS
    interface "AdminService" as AdminS
    interface "SeckillService" as SeckS
    interface "UploadService" as UpS
    interface "ChatService" as ChatS

    [AuthServiceImpl] as AuthI
    [ProductServiceImpl] as ProdI
    [CategoryServiceImpl] as CatI
    [SearchServiceImpl] as SearchI
    [CartServiceImpl] as CartI
    [OrderServiceImpl] as OrderI
    [PaymentServiceImpl] as PayI
    [RefundServiceImpl] as RefI
    [AddressServiceImpl] as AddrI
    [CommentServiceImpl] as ComI
    [MerchantServiceImpl] as McI
    [AdminServiceImpl] as AdminI
    [SeckillServiceImpl] as SeckI
    [UploadServiceImpl] as UpI
    [ChatServiceImpl] as ChatI
    [SeckillStatusScheduler\n(秒杀状态定时任务)] as SeckSch

    [DTO / VO\n(入参 / 出参)] as DTO
  }

  component "module-mapper\n(数据访问)" as Mapper #LightPink {
    [UserMapper / MerchantMapper] as UserM
    [ProductMapper / ProductSkuMapper\nCategoryMapper / SpecMapper] as ProdM
    [CartItemMapper] as CartM
    [OrderMapper / OrderItemMapper] as OrderM
    [PaymentMapper / RefundMapper] as PayM
    [AddressMapper / CommentMapper] as AddrM
    [ConversationMapper / MessageMapper] as ChatM
    [SearchHistoryMapper] as SearchM
    [SeckillCouponMapper / UserCouponMapper] as SeckM
    [OperationLogMapper\n(预留)] as OpLogM

    [Entity 实体类] as Entity
    [Mapper XML\n(MyBatis 映射)] as XML
  }

  component "common\n(基础设施)" as Common #EEEEEE {
    [Result<T> / PageResult<T>\n(统一返回)] as Result
    [ErrorCode / 各业务错误码] as ErrCode
    [BusinessException\n(业务异常)] as BusEx
    [JwtUtil\n(JWT 生成/解析)] as Utils
    [UserContext\n(ThreadLocal 用户上下文)] as Ctx
    [@Public\n(免登录注解)] as Public
    [UserRoleEnum] as Enums
  }
}

' ===== 模块间依赖 =====
Start --> API : 依赖
API --> Service : 依赖
Service --> Mapper : 依赖
Mapper --> Common : 依赖
API --> Common : 依赖(Result/异常/注解)
Service --> Common : 依赖(异常/上下文/工具)

' ===== 接口与实现 =====
AuthS <|.. AuthI
ProdS <|.. ProdI
CatS <|.. CatI
SearchS <|.. SearchI
CartS <|.. CartI
OrderS <|.. OrderI
PayS <|.. PayI
RefS <|.. RefI
AddrS <|.. AddrI
ComS <|.. ComI
McS <|.. McI
AdminS <|.. AdminI
SeckS <|.. SeckI
UpS <|.. UpI
ChatS <|.. ChatI

' ===== Controller / WebSocket 依赖 Service =====
Auth --> AuthS
Product --> ProdS
Category --> CatS
Search --> SearchS
Cart --> CartS
Order --> OrderS
Pay --> PayS
Refund --> RefS
Addr --> AddrS
Comment --> ComS
Mc --> McS
Admin --> AdminS
Seckill --> SeckS
Upload --> UpS
Chat --> ChatS
Ws --> ChatS

' ===== 外部依赖 =====
Mapper --> MySQL : MyBatis JDBC
Service --> Redis : Spring Data Redis
Service --> ES : ElasticsearchClient
Service --> OSS : 阿里云 SDK（可选）
Ws --> Redis : online:{userId} / token 校验

' ===== 横切面 =====
Start --> Jwt : 注册拦截器
Jwt --> Utils : 解析 Token
Jwt --> Ctx : 写入用户上下文
API --> ExHandler : 统一异常

@enduml
