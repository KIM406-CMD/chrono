# ============================================================
# 本地环境变量示例
#
# 复制到仓库根目录并重命名为 .env（.env 已被 .gitignore 忽略）：
#   cp script/.env.example .env
#
# script/start-backend.sh 与 start-backend.bat 会自动加载根目录 .env。
# 未配置 OSS 密钥时图片默认保存到本地 uploads/ 目录。
# ============================================================

ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# JWT 签名密钥：生产环境必须配置，至少 32 字节随机字符串
# 生成示例：openssl rand -base64 48
JWT_SECRET=

# 生产环境数据库密码（application-prod.yml 不再提供默认值）
# DB_PASSWORD=

# 可选，不填则使用 application.yaml 中的默认值
# ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# ALIYUN_OSS_BUCKET_NAME=chrono-bbs
